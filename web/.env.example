# 카카오 developers > 내 애플리케이션 > 앱 키 > REST API 키
# (백엔드의 KAKAO_CLIENT_ID 와 같은 값)
VITE_KAKAO_REST_API_KEY=

# 카카오 로그인 Redirect URI. 아래 3곳이 모두 완전히 같아야 한다.
#   1) 카카오 콘솔에 등록한 Redirect URI
#   2) 이 값 (비우면 현재 origin 기준 http://localhost:5173/auth/kakao/callback)
#   3) 백엔드 KAKAO_REDIRECT_URI (기본값 http://localhost:5173/auth/kakao/callback)
# VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# 백엔드 주소 (기본값: http://localhost:8080). 백엔드 CORS 에서 이 프론트 origin 을 허용해야 함
# VITE_API_BASE_URL=http://localhost:8080
